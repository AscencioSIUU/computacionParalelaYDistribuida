<mxfile host="app.diagrams.net">
  <diagram name="BFS Secuencial" id="bfs-flujo">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="init" value="Inicializar: cola vacía, visitados[]=false, padre[]=-1&#10;Encolar 'inicio', visitados[inicio]=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dec_cola" value="¿Cola no vacía?&#10;(frente &lt; final_cola)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="330" y="200" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="deq" value="Desencolar 'actual' = cola[frente]; frente++" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="320" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="dec_objetivo" value="¿actual == objetivo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="330" y="400" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="encontrado" value="encontrado = true&#10;break" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="600" y="410" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="rec_vecinos" value="Recorrer vecinos de grafo[actual]&#10;(lista de adyacencia)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="310" y="510" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="dec_visitado" value="¿vecino ya está&#10;en visitados?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="330" y="600" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="marcar" value="visitados[vecino]=true&#10;padre[vecino]=actual&#10;Encolar vecino (final_cola++)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="580" y="600" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="dec_masVecinos" value="¿Quedan más&#10;vecinos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="330" y="720" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="dec_encontrado_fin" value="¿encontrado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="330" y="860" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="reconstruir" value="Reconstruir camino:&#10;recorrer padre[] desde objetivo hasta inicio&#10;Invertir orden e imprimir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="120" y="980" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sinCamino" value="Imprimir&#10;&quot;No hay camino posible&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="480" y="980" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="fin" value="Fin" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="1090" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="start" target="init"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="init" target="dec_cola"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="Sí" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dec_cola" target="deq"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="deq" target="dec_objetivo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="Sí" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dec_objetivo" target="encontrado"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dec_objetivo" target="rec_vecinos"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="rec_vecinos" target="dec_visitado"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dec_visitado" target="marcar"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="Sí" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dec_visitado" target="dec_masVecinos"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="marcar" target="dec_masVecinos"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="Sí (siguiente vecino)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;" edge="1" parent="1" source="dec_masVecinos" target="dec_visitado">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="150" y="740" /><mxPoint x="150" y="640" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;" edge="1" parent="1" source="dec_masVecinos" target="dec_cola">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="150" y="760" /><mxPoint x="150" y="240" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e13" value="No (cola vacía)" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dec_cola" target="dec_encontrado_fin">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="640" y="240" /><mxPoint x="640" y="900" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="encontrado" target="dec_encontrado_fin">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="670" y="900" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e15" value="Sí" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dec_encontrado_fin" target="reconstruir"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dec_encontrado_fin" target="sinCamino"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="reconstruir" target="fin"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="sinCamino" target="fin"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
